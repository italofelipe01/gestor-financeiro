# TELEGRAM_BOT_TOKEN: token do bot criado com o @BotFather, usado para enviar os
# avisos diarios de despesas pendentes. Sem ele, a integracao com o Telegram fica
# desabilitada. Tambem pode ser configurado pela aba "Notificacoes do Telegram".
TELEGRAM_BOT_TOKEN=""

# TELEGRAM_CHAT_ID: ID do chat (pessoal ou de grupo) para onde as notificacoes sao
# enviadas. Obtenha conversando com o bot e consultando a API do Telegram.
TELEGRAM_CHAT_ID=""

# GOOGLE_APPLICATION_CREDENTIALS: caminho do arquivo .json da chave de uma conta de
# servico do Google Cloud (opcional). Com ela o app usa a Google Sheets API: a planilha
# pode ser privada (compartilhada so com o e-mail da conta de servico) e o app grava de
# volta nela. Alternativa a enviar a chave pela aba "Planilha", que a guarda em data/.
GOOGLE_APPLICATION_CREDENTIALS=""

# PORT e HOST: onde o servidor escuta. 0.0.0.0 deixa abrir o app pelo celular na mesma
# rede; o app nao tem login, entao em rede que nao e sua use 127.0.0.1.
PORT="3000"
HOST="0.0.0.0"
